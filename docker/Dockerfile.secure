# Secure Dockerfile for ChengetAi Services
# This is a hardened multi-stage build with security best practices

# Stage 1: Builder
FROM golang:1.21-alpine3.18 as builder

# Install security scanning tools
RUN apk add --no-cache git ca-certificates tzdata

# Set build arguments
ARG SERVICE_NAME

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies with verification
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build with security flags
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s -X main.Version=1.0.0" \
    -o /app/bin/service \
    ./apps/${SERVICE_NAME}/cmd/server

# Stage 2: Runtime
FROM alpine:3.18

# Install only necessary packages
RUN apk add --no-cache ca-certificates tzdata curl

# Create non-root user for running application
RUN addgroup -g 1000 appgroup && \
    adduser -D -u 1000 -G appgroup appuser

# Create necessary directories
RUN mkdir -p /app /app/logs && \
    chown -R appuser:appgroup /app

WORKDIR /app

# Copy binary from builder
COPY --from=builder --chown=appuser:appgroup /app/bin/service ./service

# Copy timezone data
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# Security: Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD curl -f http://localhost:${SERVICE_PORT:-8000}/health || exit 1

# Expose port (container-internal, mapped by docker-compose)
EXPOSE 8000

# Run the application
ENTRYPOINT ["./service"]

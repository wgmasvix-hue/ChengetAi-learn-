learn.dare.co.zw {
	# Serve the web frontend for all non-API paths
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /ready {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}

	# Security headers (supplement what the Go API already sets)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode gzip
	log {
		output stdout
		format json
	}
}

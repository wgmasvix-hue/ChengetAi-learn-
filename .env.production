# ChengetAi Learn - Production Environment
# IMPORTANT: Generate strong random values for all secrets!

# Application
APP_NAME=chengetai-learn
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

# Database
DB_USER=chengetai
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_min_20_chars
DB_NAME=chengetai
DATABASE_URL=postgres://chengetai:CHANGE_ME@postgres:5432/chengetai?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_min_32_chars_random
JWT_EXPIRY=15m

# CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://api.your-domain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Log Retention
LOG_RETENTION_DAYS=30

# NOTE: Generate strong secrets:
# Database password: openssl rand -base64 20
# JWT secret: openssl rand -base64 32

# ChengetAi Platform - Environment Configuration

# Service Configuration
ENVIRONMENT=development
LOG_LEVEL=debug

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chengetai
DB_USER=chengetai
DB_PASSWORD=chengetai_dev_password_change_in_prod
DB_POOL_SIZE=10

# Cache Configuration
REDIS_URL=redis://redis:6379
REDIS_DB=0
REDIS_PASSWORD=

# Message Queue Configuration
NATS_URL=nats://nats:4222
NATS_CLUSTER_NAME=chengetai-nats

# Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chengetai

# Search Configuration
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=xyz

# Authentication
JWT_SECRET=dev_jwt_secret_change_in_prod
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# OAuth2 Configuration (Future)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=

# DSpace Integration
DSPACE_URL=http://repo.dare.co.zw
DSPACE_API_KEY=
DSPACE_API_VERSION=v6

# Payment Configuration
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Feature Flags
FEATURE_RAG_ENABLED=true
FEATURE_VOICE_TUTOR=false
FEATURE_OFFLINE_SYNC=true
FEATURE_QUIZ_GENERATION=true

# Observability
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=admin
LOKI_ENABLED=true

# Email Configuration (For Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@chengetai.africa

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Geographic & Localization
DEFAULT_CURRENCY=USD
SUPPORTED_COUNTRIES=ZW,KE,UG,ZA,GH,NG,TZ
SUPPORTED_LANGUAGES=en,fr,sw,zu,xh
DEFAULT_TIMEZONE=Africa/Harare

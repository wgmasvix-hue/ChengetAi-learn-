# ChengetAi Platform - Environment Configuration
# SECURITY: Never commit actual secrets. Use environment variable management in production.

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Set to 'production' on live servers
ENVIRONMENT=development
# Use 'info' in production, 'debug' in development
LOG_LEVEL=debug

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chengetai
DB_USER=chengetai
# CRITICAL: Use a strong password (minimum 12 characters)
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MINIMUM_12_CHARS
DB_POOL_SIZE=10
DB_MIN_CONNS=5
DB_MAX_CONNS=25
# CRITICAL: Must be 'require' in production, 'disable' only in development
DB_SSL_MODE=disable

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_DB=0
# CRITICAL: Set a strong password in production
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MINIMUM_12_CHARS

# ============================================================================
# MESSAGE QUEUE CONFIGURATION
# ============================================================================
NATS_URL=nats://nats:4222
NATS_CLUSTER_NAME=chengetai-nats

# ============================================================================
# OBJECT STORAGE CONFIGURATION
# ============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
# CRITICAL: Change in production
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=chengetai
# CRITICAL: Use 'https' in production
MINIO_USE_SSL=false

# ============================================================================
# SEARCH CONFIGURATION
# ============================================================================
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
# CRITICAL: Use a strong API key (minimum 32 characters)
TYPESENSE_API_KEY=CHANGE_ME_STRONG_API_KEY_MIN_32_CHARS

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# CRITICAL: Use a strong secret (minimum 32 characters, use: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MINIMUM_32_CHARS_GENERATED_SECURELY
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=chengetai
JWT_AUDIENCE=chengetai-platform

# ============================================================================
# PASSWORD REQUIREMENTS
# ============================================================================
# Minimum password complexity: 8 chars, upper/lower/digit/special
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=false
# Bcrypt cost factor (10-12 recommended, higher = slower but safer)
BCRYPT_COST=12

# ============================================================================
# OAuth2 CONFIGURATION (For Future Implementation)
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=

# ============================================================================
# DSpace INTEGRATION
# ============================================================================
DSPACE_URL=http://repo.dare.co.zw
DSPACE_API_KEY=
DSPACE_API_VERSION=v6

# ============================================================================
# PAYMENT CONFIGURATION
# ============================================================================
PAYMENT_PROVIDER=stripe
# CRITICAL: Use actual keys in production
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================================================
# AI SERVICE CONFIGURATION (Phase 3)
# ============================================================================
# CRITICAL: Use actual Claude API key in production
CLAUDE_API_KEY=sk-CHANGE_ME_WITH_ACTUAL_API_KEY
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=4096
RAG_MAX_CONTEXT_LENGTH=8192
RAG_MIN_SIMILARITY=0.5
RAG_TOP_K=5

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_RAG_ENABLED=true
FEATURE_VOICE_TUTOR=false
FEATURE_OFFLINE_SYNC=true
FEATURE_QUIZ_GENERATION=true
FEATURE_ANALYTICS=true

# ============================================================================
# OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
# CRITICAL: Change in production
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
LOKI_ENABLED=true
# Send traces to external service (Jaeger, DataDog, etc)
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# EMAIL CONFIGURATION (For Notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@chengetai.africa
# Enable TLS for email
SMTP_USE_TLS=true
# Test email functionality on startup
SMTP_TEST_ENABLED=false
SMTP_TEST_TO=

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
SENTRY_DSN=
SENTRY_ENABLED=false
DATADOG_API_KEY=
DATADOG_ENABLED=false

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# CRITICAL: In production, specify exact domains (never use *)
# Format: https://domain1.com,https://domain2.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# CRITICAL: Adjust based on expected load
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
# Session configuration
SESSION_TIMEOUT=30m
# HTTPS only cookies in production
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Enable strict HTTPS in production
HSTS_MAX_AGE=31536000
# Disable in development, enable in production
HSTS_ENABLED=false

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================
# How long to retain analytics data (in days)
ANALYTICS_RETENTION_DAYS=90
# Batch size for event processing
ANALYTICS_BATCH_SIZE=100
# When to generate daily reports (24-hour format)
REPORT_GENERATION_TIME=00:00
# Enable PII redaction in logs
ANALYTICS_REDACT_PII=true

# ============================================================================
# GEOGRAPHIC & LOCALIZATION
# ============================================================================
DEFAULT_CURRENCY=USD
SUPPORTED_COUNTRIES=ZW,KE,UG,ZA,GH,NG,TZ
SUPPORTED_LANGUAGES=en,fr,sw,zu,xh
DEFAULT_TIMEZONE=Africa/Harare

# ============================================================================
# PRODUCTION-ONLY SETTINGS (Only effective when ENVIRONMENT=production)
# ============================================================================
# Force HTTPS redirect
FORCE_HTTPS=true
# Require valid SSL certificate
REQUIRE_SSL=true
# IP whitelist (comma-separated, only for admin endpoints)
ADMIN_IP_WHITELIST=
# Enable request signature verification
VERIFY_REQUEST_SIGNATURES=true

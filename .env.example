APP_NAME=chengetai-learn
APP_ENV=development
APP_PORT=8080
APP_URL=https://learn.dare.co.zw

DATABASE_URL=******localhost:5432/chengetai?sslmode=disable
DOCKER_DATABASE_URL=******postgres:5432/chengetai?sslmode=disable
REDIS_URL=redis://localhost:6379

JWT_SECRET=your-secret-key-minimum-32-characters-change-this

# CORS — comma-separated list of allowed origins
# Development: http://localhost:8081
# Production:  https://learn.dare.co.zw
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Content-Security-Policy connect-src directive
# Development: 'self' http://localhost:8080
# Production:  'self' https://learn.dare.co.zw
CSP_CONNECT_SRC='self' http://localhost:8080

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

DSPACE_BASE_URL=
DSPACE_API_KEY=

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

POSTGRES_DB=chengetai
POSTGRES_USER=chengetai
POSTGRES_PASSWORD=chengetai_dev

# ChengetAi Platform - Render Environment Template
# Copy values to Render dashboard Environment Variables

# ============================================================================
# RENDER INFRASTRUCTURE
# ============================================================================
# These will be automatically set by Render from render.yaml
# DATABASE_URL=postgresql://... (auto-set by PostgreSQL service)
# REDIS_URL=redis://... (auto-set by Redis service)

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=info
SERVICE_PORT=8000  # Adjust per service

# ============================================================================
# DATABASE CONFIGURATION
# Auto-provided by Render PostgreSQL service
# DB_HOST: PostgreSQL host (auto)
# DB_PORT: 5432 (auto)
# DB_NAME: chengetai (auto)
# DB_USER: chengetai (auto)
# DB_PASSWORD: (auto)
DB_SSL_MODE=require
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ============================================================================
# REDIS CONFIGURATION
# Auto-provided by Render Redis service
# REDIS_URL: redis://... (auto)
REDIS_DB=0

# ============================================================================
# JWT AUTHENTICATION (CRITICAL)
# Generate: openssl rand -base64 32
JWT_SECRET=YOUR_GENERATED_JWT_SECRET_32_CHARS_MINIMUM_HERE
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=chengetai
JWT_AUDIENCE=chengetai-platform

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
SESSION_TIMEOUT=30m
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
HSTS_ENABLED=true
FORCE_HTTPS=true

# ============================================================================
# AI SERVICE CONFIGURATION (Phase 3)
# ============================================================================
CLAUDE_API_KEY=sk-your-actual-claude-api-key-here
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=4096
RAG_MAX_CONTEXT_LENGTH=8192
RAG_MIN_SIMILARITY=0.5
RAG_TOP_K=5

# ============================================================================
# PAYMENT CONFIGURATION
# ============================================================================
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=sk-live-your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-id
PAYPAL_CLIENT_SECRET=your-paypal-secret

# ============================================================================
# EMAIL/NOTIFICATIONS (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@chengetai.com
SMTP_USE_TLS=true

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
LOKI_ENABLED=true
SENTRY_DSN=
DATADOG_API_KEY=

# ============================================================================
# ANALYTICS
# ============================================================================
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_BATCH_SIZE=100
REPORT_GENERATION_TIME=00:00

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_RAG_ENABLED=true
FEATURE_VOICE_TUTOR=false
FEATURE_OFFLINE_SYNC=true
FEATURE_QUIZ_GENERATION=true
FEATURE_ANALYTICS=true

# ============================================================================
# GEOGRAPHIC & LOCALIZATION
# ============================================================================
DEFAULT_CURRENCY=USD
SUPPORTED_COUNTRIES=ZW,KE,UG,ZA,GH,NG,TZ
SUPPORTED_LANGUAGES=en,fr,sw,zu,xh
DEFAULT_TIMEZONE=Africa/Harare

# ============================================================================
# NOTES
# ============================================================================
# 1. Generate JWT_SECRET: openssl rand -base64 32
# 2. Database URL will be set automatically by Render PostgreSQL service
# 3. Redis URL will be set automatically by Render Redis service
# 4. Add secrets (API keys) individually in Render dashboard
# 5. NEVER commit actual secrets to version control
# 6. Use Render's "Sync from .env" feature to load this template

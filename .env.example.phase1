# ChengetAi Learn - Phase One Environment Template
# Copy this to .env and update with your values

# Application
APP_NAME=chengetai-learn
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://chengetai:chengetai@localhost:5432/chengetai?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=change-me-to-a-secret-key-at-least-32-characters-long
JWT_EXPIRY=15m

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=true

# Future: AI Configuration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Future: Knowledge Repository
DSPACE_BASE_URL=
DSPACE_API_KEY=
